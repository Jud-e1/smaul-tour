{
  "name": "@tourism-marketplace/mobile",
  "version": "1.0.0",
  "description": "Mobile application for AI-Powered Local Tourism Marketplace",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
