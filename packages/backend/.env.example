# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tourism_marketplace
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=20

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# LLM Configuration
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4
LLM_MAX_TOKENS=2000

# Vector Database Configuration
VECTOR_DB_PROVIDER=pinecone
VECTOR_DB_API_KEY=your_pinecone_api_key
VECTOR_DB_ENVIRONMENT=us-west1-gcp
VECTOR_DB_INDEX=tourism-experiences

# Payment Configuration
PAYMENT_PROVIDER=stripe
PAYMENT_API_KEY=your_stripe_secret_key
PAYMENT_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=3600
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=2592000

# OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Email Configuration
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@tourismmarketplace.com

# Cloud Storage Configuration
STORAGE_PROVIDER=s3
STORAGE_BUCKET=tourism-marketplace-images
STORAGE_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Maps API Configuration
MAPS_API_KEY=your_google_maps_api_key

# Currency Exchange API
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD

# Frontend URLs
WEB_URL=http://localhost:3001
MOBILE_DEEP_LINK_SCHEME=tourismmarketplace
